    <script>
        let appProfile = {
            dinas: "DINAS PENDIDIKAN DAN KEBUDAYAAN",
            sekolah: "SMA NEGERI 1 EDUKASI KOTA",
            npsn: "20104921",
            alamat: "Jl. Pendidikan No. 45, Kecamatan Kota, Provinsi Jawa",
            kepsek: "Drs. H. Mulyadi, M.Pd",
            nipKepsek: "19680312 199403 1 004",
            pengurus: "Ahmad Hidayat, S.Pd",
            nipPengurus: "19850720 201001 1 012",
            logoPemda: "https://placehold.co/120x120/1e3a8a/ffffff?text=PEMDA",
            logoSekolah: "https://placehold.co/120x120/2563eb/ffffff?text=SEKOLAH",
            ttd: "https://placehold.co/200x100/ffffff/000000?text=TTD+Digital"
        };

        let inventoryItems = [
            { id: 1, code: "INV/2026/ELK/001", name: "Laptop Asus Chromebook", category: "Elektronik & IT", brand: "Core i3 8GB RAM 256GB SSD", location: "Lab Komputer 1", qty: 15, condition: "Baik", academicYear: "2025/2026" },
            { id: 2, code: "INV/2026/MBL/002", name: "Meja Belajar Siswa Kayu Jati", category: "Mebel & Furnitur", brand: "Kayu Jati Grade A", location: "Ruang Kelas X-A", qty: 36, condition: "Baik", academicYear: "2025/2026" },
            { id: 3, code: "INV/2026/MBL/003", name: "Kursi Belajar Siswa Iron Leg", category: "Mebel & Furnitur", brand: "Rangka Besi Hitam", location: "Ruang Kelas X-A", qty: 36, condition: "Baik", academicYear: "2025/2026" },
            { id: 4, code: "INV/2026/ELK/004", name: "Proyektor Epson EB-X500", category: "Elektronik & IT", brand: "Epson 3600 Lumens", location: "Ruang Rapat Guru", qty: 2, condition: "Baik", academicYear: "2024/2025" },
            { id: 5, code: "INV/2026/OLG/005", name: "Bola Basket Molten GG7X", category: "Peralatan Olahraga", brand: "Molten Leather Approved", location: "Gudang Olahraga", qty: 10, condition: "Kurang Baik", academicYear: "2024/2025" },
            { id: 6, code: "INV/2026/LAB/006", name: "Mikroskop Binokuler Digital", category: "Alat Peraga & Lab", brand: "Olympus CX23", location: "Laboratorium Biologi", qty: 8, condition: "Baik", academicYear: "2025/2026" },
            { id: 7, code: "INV/2026/ELK/007", name: "AC Split 2 PK Panasonic", category: "Elektronik & IT", brand: "Panasonic Inverter R32", location: "Ruang Guru", qty: 4, condition: "Rusak Berat", academicYear: "2023/2024" }
        ];

        let selectedYear = "2025/2026";
        let activeModalType = "report"; // 'report' or 'label'

        window.onload = function() {
            loadLocalStorage();
            renderProfile();
            renderInventoryTable();
            updateStats();
        };

        function loadLocalStorage() {
            const savedProfile = localStorage.getItem('simas_profile');
            if (savedProfile) appProfile = JSON.parse(savedProfile);

            const savedInventory = localStorage.getItem('simas_inventory');
            if (savedInventory) inventoryItems = JSON.parse(savedInventory);
        }

        function saveLocalStorage() {
            localStorage.setItem('simas_profile', JSON.stringify(appProfile));
            localStorage.setItem('simas_inventory', JSON.stringify(inventoryItems));
        }

        function handleLogin(e) {
            e.preventDefault();
            document.getElementById('loginScreen').classList.add('hidden');
            document.getElementById('mainDashboard').classList.remove('hidden');
            showNotification('Selamat Datang di SIMAS Kedinasan!', 'success');
        }

        function logout() {
            document.getElementById('mainDashboard').classList.add('hidden');
            document.getElementById('loginScreen').classList.remove('hidden');
            showNotification('Anda berhasil keluar.', 'info');
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-brand-50', 'text-brand-700');
                btn.classList.add('text-slate-600');
            });

            document.getElementById(`sec-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tabBtn-${tabName}`);
            activeBtn.classList.add('bg-brand-50', 'text-brand-700');
            activeBtn.classList.remove('text-slate-600');
        }

        function handleYearChange(val) {
            selectedYear = val;
            renderInventoryTable();
            updateStats();
        }

        function getFilteredInventory() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const cat = document.getElementById('filterCategory').value;
            const cond = document.getElementById('filterCondition').value;

            return inventoryItems.filter(item => {
                const matchesSearch = item.code.toLowerCase().includes(search) || 
                                      item.name.toLowerCase().includes(search) || 
                                      item.brand.toLowerCase().includes(search) ||
                                      item.location.toLowerCase().includes(search);
                const matchesCat = (cat === 'ALL' || item.category === cat);
                const matchesCond = (cond === 'ALL' || item.condition === cond);
                const matchesYear = (selectedYear === 'ALL' || item.academicYear === selectedYear);

                return matchesSearch && matchesCat && matchesCond && matchesYear;
            });
        }

        function renderInventoryTable() {
            const tbody = document.getElementById('inventoryTableBody');
            const emptyState = document.getElementById('emptyState');
            const items = getFilteredInventory();

            tbody.innerHTML = '';

            if (items.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            items.forEach((item, index) => {
                let condClass = 'bg-emerald-100 text-emerald-700';
                if (item.condition === 'Kurang Baik') condClass = 'bg-amber-100 text-amber-700';
                if (item.condition === 'Rusak Berat') condClass = 'bg-rose-100 text-rose-700';

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                tr.innerHTML = `
                    <td class="p-4 text-center font-bold text-slate-400">${index + 1}</td>
                    <td class="p-4 font-mono font-bold text-brand-700">${item.code}</td>
                    <td class="p-4 font-bold text-slate-800">${item.name}</td>
                    <td class="p-4"><span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-lg text-[11px] font-semibold">${item.category}</span></td>
                    <td class="p-4 text-slate-500">${item.brand || '-'}</td>
                    <td class="p-4 font-medium text-slate-700">${item.location}</td>
                    <td class="p-4 text-center">
                        <span class="px-3 py-1 bg-blue-50 text-brand-700 font-extrabold rounded-xl border border-blue-200">${item.qty} Unit</span>
                    </td>
                    <td class="p-4 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase ${condClass}">${item.condition}</span>
                    </td>
                    <td class="p-4 text-center font-semibold text-slate-500">${item.academicYear}</td>
                    <td class="p-4 text-center">
                        <div class="flex items-center justify-center space-x-2">
                            <button onclick="openEditItemModal(${item.id})" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="Edit Item">
                                <i class="fa-solid fa-pen-to-square text-sm"></i>
                            </button>
                            <button onclick="deleteItem(${item.id})" class="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition" title="Hapus Item">
                                <i class="fa-solid fa-trash text-sm"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterTable() {
            renderInventoryTable();
        }

        function updateStats() {
            const items = getFilteredInventory();
            const totalItems = items.length;
            const totalQty = items.reduce((acc, curr) => acc + parseInt(curr.qty || 0), 0);
            const damagedQty = items.filter(i => i.condition === 'Rusak Berat').reduce((acc, curr) => acc + parseInt(curr.qty || 0), 0);
            const uniqueRooms = new Set(items.map(i => i.location)).size;

            document.getElementById('statTotalItems').innerText = totalItems;
            document.getElementById('statTotalQty').innerText = totalQty;
            document.getElementById('statDamagedQty').innerText = damagedQty;
            document.getElementById('statRooms').innerText = uniqueRooms;
        }

        function openAddItemModal() {
            document.getElementById('itemModal').classList.remove('hidden');
            document.getElementById('modalTitle').innerText = 'Tambah Barang Inventaris Baru';
            document.getElementById('itemForm').reset();
            document.getElementById('itemEditId').value = '';
            document.getElementById('itemCode').value = `INV/${new Date().getFullYear()}/AST/00` + (inventoryItems.length + 1);
        }

        function openEditItemModal(id) {
            const item = inventoryItems.find(i => i.id === id);
            if (!item) return;

            document.getElementById('itemModal').classList.remove('hidden');
            document.getElementById('modalTitle').innerText = 'Edit Data Barang Inventaris';
            document.getElementById('itemEditId').value = item.id;
            document.getElementById('itemCode').value = item.code;
            document.getElementById('itemName').value = item.name;
            document.getElementById('itemCategory').value = item.category;
            document.getElementById('itemBrand').value = item.brand;
            document.getElementById('itemLocation').value = item.location;
            document.getElementById('itemQty').value = item.qty;
            document.getElementById('itemCondition').value = item.condition;
            document.getElementById('itemAcademicYear').value = item.academicYear;
        }

        function closeItemModal() {
            document.getElementById('itemModal').classList.add('hidden');
        }

        function saveItem(e) {
            e.preventDefault();
            const editId = document.getElementById('itemEditId').value;

            const itemData = {
                id: editId ? parseInt(editId) : Date.now(),
                code: document.getElementById('itemCode').value,
                name: document.getElementById('itemName').value,
                category: document.getElementById('itemCategory').value,
                brand: document.getElementById('itemBrand').value,
                location: document.getElementById('itemLocation').value,
                qty: parseInt(document.getElementById('itemQty').value || 1),
                condition: document.getElementById('itemCondition').value,
                academicYear: document.getElementById('itemAcademicYear').value
            };

            if (editId) {
                const index = inventoryItems.findIndex(i => i.id === parseInt(editId));
                if (index !== -1) inventoryItems[index] = itemData;
                showNotification('Data barang berhasil diperbarui!', 'success');
            } else {
                inventoryItems.unshift(itemData);
                showNotification('Barang baru berhasil ditambahkan!', 'success');
            }

            saveLocalStorage();
            renderInventoryTable();
            updateStats();
            closeItemModal();
        }

        function deleteItem(id) {
            if (confirm('Apakah Anda yakin ingin menghapus barang ini?')) {
                inventoryItems = inventoryItems.filter(i => i.id !== id);
                saveLocalStorage();
                renderInventoryTable();
                updateStats();
                showNotification('Barang berhasil dihapus.', 'info');
            }
        }

        function handleImageUpload(event, previewId, dataKey) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById(previewId).src = e.target.result;
                appProfile[dataKey] = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function renderProfile() {
            document.getElementById('profDinas').value = appProfile.dinas;
            document.getElementById('profSekolah').value = appProfile.sekolah;
            document.getElementById('profNPSN').value = appProfile.npsn;
            document.getElementById('profAlamat').value = appProfile.alamat;
            document.getElementById('profKepsek').value = appProfile.kepsek;
            document.getElementById('profNipKepsek').value = appProfile.nipKepsek;
            document.getElementById('profPengurus').value = appProfile.pengurus;
            document.getElementById('profNipPengurus').value = appProfile.nipPengurus;

            if (appProfile.logoPemda) document.getElementById('previewLogoPemda').src = appProfile.logoPemda;
            if (appProfile.logoSekolah) document.getElementById('previewLogoSekolah').src = appProfile.logoSekolah;
            if (appProfile.ttd) document.getElementById('previewTTD').src = appProfile.ttd;

            document.getElementById('headerSchoolName').innerText = appProfile.sekolah;
            document.getElementById('headerAdminName').innerText = appProfile.pengurus;
        }

        function saveProfile(e) {
            e.preventDefault();
            appProfile.dinas = document.getElementById('profDinas').value;
            appProfile.sekolah = document.getElementById('profSekolah').value;
            appProfile.npsn = document.getElementById('profNPSN').value;
            appProfile.alamat = document.getElementById('profAlamat').value;
            appProfile.kepsek = document.getElementById('profKepsek').value;
            appProfile.nipKepsek = document.getElementById('profNipKepsek').value;
            appProfile.pengurus = document.getElementById('profPengurus').value;
            appProfile.nipPengurus = document.getElementById('profNipPengurus').value;

            saveLocalStorage();
            renderProfile();
            showNotification('Profil sekolah & kop kedinasan berhasil disimpan!', 'success');
        }

        function generateReportHTML() {
            const templateType = document.getElementById('reportTemplateType').value;
            const items = getFilteredInventory();

            let titleText = "LAPORAN INVENTARIS SARANA DAN PRASARANA";
            if (templateType === 'KIB_B') titleText = "KARTU INVENTARIS BARANG (KIB B) - PERALATAN DAN MESIN";
            if (templateType === 'REKAP_RUANG') titleText = "LAPORAN REKAPITULASI ASET PER RUANGAN";
            if (templateType === 'KONDISI_BARANG') titleText = "LAPORAN REKAPITULASI KONDISI BARANG INVENTARIS";

            let tableRowsHtml = '';
            items.forEach((item, index) => {
                tableRowsHtml += `
                    <tr>
                        <td style="text-align: center; font-weight: bold; border: 2px solid #000; padding: 6px;">${index + 1}</td>
                        <td style="font-family: monospace; font-weight: bold; border: 2px solid #000; padding: 6px;">${item.code}</td>
                        <td style="font-weight: bold; border: 2px solid #000; padding: 6px;">${item.name}</td>
                        <td style="border: 2px solid #000; padding: 6px;">${item.category}</td>
                        <td style="border: 2px solid #000; padding: 6px;">${item.brand || '-'}</td>
                        <td style="border: 2px solid #000; padding: 6px;">${item.location}</td>
                        <td style="text-align: center; font-weight: bold; border: 2px solid #000; padding: 6px;">${item.qty} Unit</td>
                        <td style="text-align: center; font-weight: bold; border: 2px solid #000; padding: 6px;">${item.condition}</td>
                        <td style="text-align: center; border: 2px solid #000; padding: 6px;">${item.academicYear}</td>
                    </tr>
                `;
            });

            return `
                <div style="font-family: Arial, sans-serif; color: #000; line-height: 1.3;">
                    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 4px double #000; padding-bottom: 12px; margin-bottom: 15px;">
                        <img src="${appProfile.logoPemda}" style="width: 75px; height: 75px; object-fit: contain;">
                        <div style="text-align: center; flex: 1; padding: 0 10px;">
                            <h4 style="margin:0; font-size: 13px; font-weight: bold; text-transform: uppercase;">${appProfile.dinas}</h4>
                            <h2 style="margin: 2px 0; font-size: 18px; font-weight: 800; text-transform: uppercase;">${appProfile.sekolah}</h2>
                            <p style="margin:0; font-size: 11px;">NPSN: ${appProfile.npsn} | Alamat: ${appProfile.alamat}</p>
                        </div>
                        <img src="${appProfile.logoSekolah}" style="width: 75px; height: 75px; object-fit: contain;">
                    </div>

                    <div style="text-align: center; margin-bottom: 20px;">
                        <h3 style="margin: 0; font-size: 14px; font-weight: bold; text-decoration: underline;">${titleText}</h3>
                        <p style="margin: 3px 0 0 0; font-size: 11px; font-weight: bold;">TAHUN AJARAN: ${selectedYear === 'ALL' ? 'SEMUA TAHUN AJARAN' : selectedYear}</p>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 30px;">
                        <thead>
                            <tr style="background-color: #e5e7eb;">
                                <th style="width: 35px; text-align: center; border: 2px solid #000; padding: 6px; font-weight: bold;">NO</th>
                                <th style="border: 2px solid #000; padding: 6px; font-weight: bold;">KODE BARANG</th>
                                <th style="border: 2px solid #000; padding: 6px; font-weight: bold;">NAMA BARANG</th>
                                <th style="border: 2px solid #000; padding: 6px; font-weight: bold;">KATEGORI</th>
                                <th style="border: 2px solid #000; padding: 6px; font-weight: bold;">MERK / SPESIFIKASI</th>
                                <th style="border: 2px solid #000; padding: 6px; font-weight: bold;">LOKASI / RUANG</th>
                                <th style="text-align: center; border: 2px solid #000; padding: 6px; font-weight: bold;">JUMLAH</th>
                                <th style="text-align: center; border: 2px solid #000; padding: 6px; font-weight: bold;">KONDISI</th>
                                <th style="text-align: center; border: 2px solid #000; padding: 6px; font-weight: bold;">T.A.</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tableRowsHtml || '<tr><td colspan="9" style="text-align:center; border: 2px solid #000; padding: 10px;">Tidak ada data barang.</td></tr>'}
                        </tbody>
                    </table>

                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-top: 40px; page-break-inside: avoid;">
                        <div style="text-align: center; width: 220px;">
                            <p style="margin: 0;">Mengetahui,</p>
                            <p style="margin: 0 0 50px 0; font-weight: bold;">Kepala Sekolah</p>
                            <p style="margin: 0; font-weight: bold; text-decoration: underline;">${appProfile.kepsek}</p>
                            <p style="margin: 0;">NIP. ${appProfile.nipKepsek}</p>
                        </div>

                        <div style="text-align: center; width: 220px;">
                            <p style="margin: 0;">Kota, ${new Date().toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'})}</p>
                            <p style="margin: 0 0 10px 0; font-weight: bold;">Pengurus Barang Sarpras</p>
                            <img src="${appProfile.ttd}" style="height: 40px; margin: 0 auto; display: block;">
                            <p style="margin: 5px 0 0 0; font-weight: bold; text-decoration: underline;">${appProfile.pengurus}</p>
                            <p style="margin: 0;">NIP. ${appProfile.nipPengurus}</p>
                        </div>
                    </div>
                </div>
            `;
        }

        function generateLabelHTML() {
            const gridOption = document.getElementById('labelGridOption').value;
            const categoryFilter = document.getElementById('labelCategoryFilter').value;
            const showLogo = document.getElementById('labelShowLogo').value;

            const items = getFilteredInventory().filter(i => categoryFilter === 'ALL' || i.category === categoryFilter);

            let gridCols = 'grid-template-columns: repeat(3, 1fr);';
            if (gridOption === '2x5') gridCols = 'grid-template-columns: repeat(2, 1fr);';
            if (gridOption === '4x8') gridCols = 'grid-template-columns: repeat(4, 1fr);';

            let expandedLabels = [];
            items.forEach(item => {
                for (let q = 1; q <= item.qty; q++) {
                    expandedLabels.push({
                        ...item,
                        unitIndex: q
                    });
                }
            });

            let labelsHtml = `<div style="display: grid; ${gridCols} gap: 10px;">`;

            expandedLabels.forEach(lbl => {
                labelsHtml += `
                    <div style="border: 2px dashed #000; border-radius: 6px; padding: 6px; background: #fff; font-family: Arial, sans-serif; page-break-inside: avoid;">
                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1.5px solid #000; padding-bottom: 4px; margin-bottom: 4px;">
                            ${showLogo === 'YES' ? `<img src="${appProfile.logoSekolah}" style="width: 22px; height: 22px; object-fit: contain;">` : ''}
                            <div style="text-align: center; flex: 1; padding: 0 2px;">
                                <div style="font-size: 8px; font-weight: 800; text-transform: uppercase; line-height: 1;">INVENTARIS SEKOLAH</div>
                                <div style="font-size: 7px; font-weight: 700; color: #333;">${appProfile.sekolah}</div>
                            </div>
                        </div>
                        <div style="font-size: 8px; line-height: 1.2;">
                            <div style="font-weight: bold; font-size: 9px; margin-bottom: 2px; color: #000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${lbl.name}</div>
                            <div style="font-family: monospace; font-weight: bold; font-size: 8px;">KODE: ${lbl.code}-${lbl.unitIndex}</div>
                            <div>RUANG: ${lbl.location}</div>
                            <div style="display: flex; justify-content: space-between; font-size: 7px; margin-top: 2px; font-weight: bold; color: #444;">
                                <span>TA: ${lbl.academicYear}</span>
                                <span>UNIT: ${lbl.unitIndex}/${lbl.qty}</span>
                            </div>
                        </div>
                    </div>
                `;
            });

            labelsHtml += `</div>`;

            if (expandedLabels.length === 0) {
                labelsHtml = `<div style="text-align:center; padding: 40px; color:#999; font-weight:bold;">Tidak ada data label untuk dicetak.</div>`;
            }

            return labelsHtml;
        }

        function openPrintPreviewModal(type) {
            activeModalType = type;
            const modal = document.getElementById('printPreviewModal');

            if (type === 'report') {
                document.getElementById('previewModalBadge').innerText = "LAPORAN KEDINASAN";
                document.getElementById('modalOrientationSelect').value = document.getElementById('reportOrientation').value;
                document.getElementById('modalPaperSizeSelect').value = document.getElementById('reportPaperSize').value;
            } else {
                document.getElementById('previewModalBadge').innerText = "LEMBAR STIKER LABEL";
                document.getElementById('modalOrientationSelect').value = "PORTRAIT";
                document.getElementById('modalPaperSizeSelect').value = "A4";
            }

            modal.classList.remove('hidden');
            updatePreviewModalPaper();
        }

        function closePrintPreviewModal() {
            document.getElementById('printPreviewModal').classList.add('hidden');
        }

        function updatePreviewModalPaper() {
            const paperContainer = document.getElementById('modalPaperContainer');
            const orientation = document.getElementById('modalOrientationSelect').value;
            const paperSize = document.getElementById('modalPaperSizeSelect').value;

            const paperDimensions = {
                'A4': { w: 794, h: 1123 },
                'F4': { w: 813, h: 1247 },
                'LEGAL': { w: 816, h: 1344 },
                'LETTER': { w: 816, h: 1056 }
            };

            const baseDim = paperDimensions[paperSize] || paperDimensions['A4'];
            let widthPx = baseDim.w;
            let heightPx = baseDim.h;

            if (orientation === 'LANDSCAPE') {
                widthPx = baseDim.h;
                heightPx = baseDim.w;
            }

            paperContainer.style.width = `${widthPx}px`;
            paperContainer.style.minHeight = `${heightPx}px`;

            const contentArea = document.getElementById('printModalContentArea');
            if (activeModalType === 'report') {
                contentArea.innerHTML = generateReportHTML();
            } else {
                contentArea.innerHTML = generateLabelHTML();
            }
        }

        function directExecutePrint(type) {
            let orientation = 'landscape';
            let paperSize = 'a4';

            if (type === 'report') {
                orientation = document.getElementById('reportOrientation').value.toLowerCase();
                paperSize = document.getElementById('reportPaperSize').value.toLowerCase();
            } else {
                orientation = 'portrait';
                paperSize = 'a4';
            }

            const htmlContent = (type === 'report') ? generateReportHTML() : generateLabelHTML();

            const printIframe = document.getElementById('printIframe');
            const iframeDoc = printIframe.contentWindow.document;

            iframeDoc.open();
            iframeDoc.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>SIMAS - Cetak Dokumen Kedinasan</title>
                    <style>
                        @page {
                            size: ${paperSize} ${orientation};
                            margin: 10mm;
                        }
                        body {
                            font-family: Arial, sans-serif;
                            margin: 0;
                            padding: 0;
                            background: #ffffff;
                            color: #000000;
                        }
                        * {
                            box-sizing: border-box;
                        }
                    </style>
                </head>
                <body>
                    ${htmlContent}
                </body>
                </html>
            `);
            iframeDoc.close();

            // Delay trigger to allow image loading
            setTimeout(() => {
                printIframe.contentWindow.focus();
                printIframe.contentWindow.print();
            }, 300);
        }

        function triggerModalPrint() {
            directExecutePrint(activeModalType);
        }

        function exportToExcel() {
            const items = getFilteredInventory();
            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "No,Kode Barang,Nama Barang,Kategori,Merk/Spesifikasi,Lokasi/Ruangan,Quantity,Kondisi,Tahun Ajaran\n";

            items.forEach((item, index) => {
                const row = [
                    index + 1,
                    `"${item.code}"`,
                    `"${item.name}"`,
                    `"${item.category}"`,
                    `"${item.brand || '-'}"`,
                    `"${item.location}"`,
                    item.qty,
                    `"${item.condition}"`,
                    `"${item.academicYear}"`
                ].join(",");
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Rekap_Inventaris_Sarpras_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showNotification('Rekap data berhasil diekspor ke format Excel / CSV!', 'success');
        }

        function showNotification(msg, type = 'info') {
            const toast = document.getElementById('toast');
            const content = document.getElementById('toastContent');
            const message = document.getElementById('toastMessage');
            const icon = document.getElementById('toastIcon');

            message.innerText = msg;

            if (type === 'success') {
                content.className = "px-4 py-3 rounded-xl shadow-xl text-xs font-bold text-white flex items-center space-x-2 bg-emerald-600";
                icon.className = "fa-solid fa-circle-check";
            } else if (type === 'info') {
                content.className = "px-4 py-3 rounded-xl shadow-xl text-xs font-bold text-white flex items-center space-x-2 bg-brand-600";
                icon.className = "fa-solid fa-circle-info";
            } else {
                content.className = "px-4 py-3 rounded-xl shadow-xl text-xs font-bold text-white flex items-center space-x-2 bg-rose-600";
                icon.className = "fa-solid fa-circle-exclamation";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
