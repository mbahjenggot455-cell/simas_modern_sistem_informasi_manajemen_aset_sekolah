<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIMAS - Sistem Informasi Manajemen Aset Sekolah</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Realistic Paper Sheet Styling */
        .paper-sheet {
            background: #ffffff;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            margin: 0 auto;
            color: #000000;
            transition: all 0.2s ease-in-out;
        }

        /* Official Thick Table Borders for Kedinasan Reports */
        .table-official {
            width: 100%;
            border-collapse: collapse !important;
        }
        .table-official th, .table-official td {
            border: 2px solid #000000 !important;
            padding: 6px 8px !important;
            color: #000000 !important;
        }
        .table-official th {
            background-color: #e5e7eb !important;
            font-weight: 800 !important;
            text-transform: uppercase;
        }

        /* Sticker Label Border with Cutting Lines */
        .sticker-card {
            border: 2px dashed #000000 !important;
            border-radius: 6px;
            padding: 6px;
            background: #ffffff;
            page-break-inside: avoid;
        }

        /* Hide elements during print */
        @media print {
            body * {
                visibility: hidden !important;
            }
            #printModalContentArea, #printModalContentArea * {
                visibility: visible !important;
            }
            #printModalContentArea {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                color: black !important;
                box-shadow: none !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <div id="app" class="min-h-screen flex flex-col relative">

        <!-- 1. HALAMAN LOGIN MUKA DEPAN / LANDING PAGE -->
        <div id="loginScreen" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-br from-slate-900 via-brand-900 to-indigo-950 p-4">
            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-8 shadow-2xl relative z-10 text-white">
                <div class="text-center mb-8">
                    <div class="w-20 h-20 mx-auto bg-white/20 backdrop-blur-md rounded-2xl p-3 flex items-center justify-center border border-white/30 shadow-inner mb-4">
                        <i class="fa-solid fa-boxes-packing text-4xl text-blue-400"></i>
                    </div>
                    <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-blue-100 to-blue-300 bg-clip-text text-transparent">SIMAS APP</h1>
                    <p class="text-xs text-slate-300 mt-1 uppercase tracking-widest font-semibold">Sistem Informasi Manajemen Aset Sekolah</p>
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Username / NIP</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-user"></i></span>
                            <input type="text" id="loginUser" required value="admin.sarpras" class="w-full pl-10 pr-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:bg-white/20 transition" placeholder="Masukkan ID Pengguna">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Kata Sandi</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="loginPass" required value="admin123" class="w-full pl-10 pr-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:bg-white/20 transition" placeholder="••••••••">
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-xs text-slate-300">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" checked class="rounded border-white/20 bg-white/10 text-blue-500 focus:ring-blue-400">
                            <span>Ingat Sesi Login</span>
                        </label>
                        <span class="text-blue-300 hover:underline cursor-pointer" onclick="showNotification('Username: admin.sarpras | Password: admin123', 'info')">Akses Demo</span>
                    </div>

                    <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 transition duration-200 flex items-center justify-center space-x-2">
                        <span>MASUK KE DASBOR</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                <div class="mt-8 text-center text-xs text-slate-400 border-t border-white/10 pt-4">
                    <p>&copy; 2026 SIMAS Kedinasan Sarpras v3.8</p>
                </div>
            </div>
        </div>

        <!-- 2. MAIN DASHBOARD APP -->
        <div id="mainDashboard" class="hidden flex-1 flex flex-col">
            
            <header class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30 no-print">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="bg-brand-600 text-white p-2.5 rounded-xl shadow-md flex items-center justify-center">
                            <i class="fa-solid fa-boxes-stacked text-lg"></i>
                        </div>
                        <div>
                            <span class="font-black text-lg text-slate-800 tracking-tight flex items-center space-x-2">
                                <span>SIMAS</span>
                                <span class="text-xs font-semibold px-2 py-0.5 bg-brand-100 text-brand-700 rounded-full">KEDINASAN</span>
                            </span>
                            <p class="text-xs text-slate-500 font-medium hidden sm:block" id="headerSchoolName">SMA Negeri 1 Edukasi Kota</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 sm:space-x-4">
                        <div class="flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">
                            <i class="fa-solid fa-calendar-days text-brand-600 text-xs"></i>
                            <span class="text-xs font-bold text-slate-600 hidden md:inline">TA:</span>
                            <select id="globalAcademicYear" onchange="handleYearChange(this.value)" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                                <option value="ALL">Semua T.A.</option>
                                <option value="2023/2024">2023/2024</option>
                                <option value="2024/2025">2024/2025</option>
                                <option value="2025/2026" selected>2025/2026</option>
                                <option value="2026/2027">2026/2027</option>
                            </select>
                        </div>

                        <div class="flex items-center space-x-3 border-l pl-3 border-slate-200">
                            <img id="userHeaderAvatar" src="https://placehold.co/100x100/2563eb/ffffff?text=ADM" alt="Avatar" class="w-9 h-9 rounded-full border-2 border-brand-500 object-cover shadow-sm">
                            <div class="hidden md:block text-left">
                                <div class="text-xs font-bold text-slate-800" id="headerAdminName">Ahmad Hidayat, S.Pd</div>
                                <div class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold">Pengurus Barang</div>
                            </div>
                            <button onclick="logout()" title="Keluar" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition">
                                <i class="fa-solid fa-power-off text-base"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <nav class="bg-white border-b border-slate-200 no-print">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-1 sm:space-x-4 overflow-x-auto py-2">
                    <button onclick="switchTab('inventory')" id="tabBtn-inventory" class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition whitespace-nowrap bg-brand-50 text-brand-700">
                        <i class="fa-solid fa-list-check"></i>
                        <span>Inventaris & Quantity</span>
                    </button>
                    <button onclick="switchTab('reports')" id="tabBtn-reports" class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100">
                        <i class="fa-solid fa-file-invoice"></i>
                        <span>Laporan Kedinasan</span>
                    </button>
                    <button onclick="switchTab('labels')" id="tabBtn-labels" class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100">
                        <i class="fa-solid fa-tags"></i>
                        <span>Cetak Label Stiker</span>
                    </button>
                    <button onclick="switchTab('profile')" id="tabBtn-profile" class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Pengaturan Profil & Kop</span>
                    </button>
                </div>
            </nav>

            <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
                
                <section id="sec-inventory" class="tab-content space-y-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-blue-100 text-blue-600 rounded-xl"><i class="fa-solid fa-cubes text-xl"></i></div>
                            <div>
                                <p class="text-xs font-medium text-slate-500">Total Jenis Barang</p>
                                <h3 id="statTotalItems" class="text-xl font-black text-slate-800">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-emerald-100 text-emerald-600 rounded-xl"><i class="fa-solid fa-layer-group text-xl"></i></div>
                            <div>
                                <p class="text-xs font-medium text-slate-500">Total Unit (Quantity)</p>
                                <h3 id="statTotalQty" class="text-xl font-black text-slate-800">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-amber-100 text-amber-600 rounded-xl"><i class="fa-solid fa-triangle-exclamation text-xl"></i></div>
                            <div>
                                <p class="text-xs font-medium text-slate-500">Barang Rusak</p>
                                <h3 id="statDamagedQty" class="text-xl font-black text-slate-800">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-purple-100 text-purple-600 rounded-xl"><i class="fa-solid fa-door-open text-xl"></i></div>
                            <div>
                                <p class="text-xs font-medium text-slate-500">Total Ruangan</p>
                                <h3 id="statRooms" class="text-xl font-black text-slate-800">0</h3>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col lg:flex-row items-center justify-between gap-4">
                        <div class="flex flex-1 flex-col sm:flex-row items-center gap-3 w-full">
                            <div class="relative w-full sm:w-72">
                                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text" id="searchInput" oninput="filterTable()" placeholder="Cari kode, nama, merk..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            </div>

                            <select id="filterCategory" onchange="filterTable()" class="w-full sm:w-auto px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                <option value="ALL">Semua Kategori</option>
                                <option value="Elektronik & IT">Elektronik & IT</option>
                                <option value="Mebel & Furnitur">Mebel & Furnitur</option>
                                <option value="Peralatan Olahraga">Peralatan Olahraga</option>
                                <option value="Buku & Perpustakaan">Buku & Perpustakaan</option>
                                <option value="Alat Peraga & Lab">Alat Peraga & Lab</option>
                                <option value="Kendaraan & Mesin">Kendaraan & Mesin</option>
                            </select>

                            <select id="filterCondition" onchange="filterTable()" class="w-full sm:w-auto px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                <option value="ALL">Semua Kondisi</option>
                                <option value="Baik">Baik (B)</option>
                                <option value="Kurang Baik">Kurang Baik (KB)</option>
                                <option value="Rusak Berat">Rusak Berat (RB)</option>
                            </select>
                        </div>

                        <div class="flex items-center space-x-2 w-full lg:w-auto justify-end">
                            <button onclick="exportToExcel()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center space-x-2 shadow-sm">
                                <i class="fa-solid fa-file-excel"></i>
                                <span>Ekspor Excel</span>
                            </button>
                            <button onclick="openAddItemModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold transition flex items-center space-x-2 shadow-sm">
                                <i class="fa-solid fa-plus"></i>
                                <span>Tambah Barang Baru</span>
                            </button>
                        </div>
                    </div>

                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-50 text-slate-700 uppercase font-bold tracking-wider border-b border-slate-200">
                                    <tr>
                                        <th class="p-4 text-center">No</th>
                                        <th class="p-4">Kode Barang</th>
                                        <th class="p-4">Nama Barang</th>
                                        <th class="p-4">Kategori</th>
                                        <th class="p-4">Merk / Spesifikasi</th>
                                        <th class="p-4">Lokasi / Ruangan</th>
                                        <th class="p-4 text-center">Quantity</th>
                                        <th class="p-4 text-center">Kondisi</th>
                                        <th class="p-4 text-center">T.A.</th>
                                        <th class="p-4 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="inventoryTableBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                        <div id="emptyState" class="hidden p-8 text-center text-slate-400">
                            <i class="fa-solid fa-box-open text-4xl mb-2"></i>
                            <p class="font-medium">Tidak ada data barang ditemukan.</p>
                        </div>
                    </div>
                </section>

                <section id="sec-reports" class="tab-content hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                        <h2 class="text-base font-bold text-slate-800 flex items-center space-x-2">
                            <i class="fa-solid fa-file-pdf text-brand-600"></i>
                            <span>Konfigurasi Cetak & Dokumen Laporan Kedinasan</span>
                        </h2>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Jenis Standar Laporan Sarpras</label>
                                <select id="reportTemplateType" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="KIB_B">Format KIB B (Peralatan & Mesin)</option>
                                    <option value="REKAP_RUANG">Laporan Rekapitulasi Per Ruangan</option>
                                    <option value="KONDISI_BARANG">Laporan Rekapitulasi Kondisi Barang</option>
                                    <option value="STANDAR_SAPRAS" selected>Standar Laporan Aset Sarpras Pemda / Kemdikbud</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Orientasi Cetak</label>
                                <select id="reportOrientation" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="LANDSCAPE" selected>Landscape (Default Kedinasan)</option>
                                    <option value="PORTRAIT">Portrait</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Ukuran Kertas Standar</label>
                                <select id="reportPaperSize" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="A4" selected>A4 (210 x 297 mm)</option>
                                    <option value="F4">F4 / Folio (215 x 330 mm)</option>
                                    <option value="LEGAL">Legal (216 x 356 mm)</option>
                                    <option value="LETTER">Letter (216 x 279 mm)</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-slate-100 flex-wrap gap-3">
                            <span class="text-xs text-slate-500 italic"><i class="fa-solid fa-circle-info text-brand-500 mr-1"></i> Langsung memunculkan dialog pencetakan printer / Save PDF.</span>
                            <div class="flex space-x-2">
                                <button onclick="openPrintPreviewModal('report')" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition flex items-center space-x-2 border">
                                    <i class="fa-solid fa-eye"></i>
                                    <span>PRATINJAU KERTAS</span>
                                </button>
                                <button onclick="directExecutePrint('report')" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs transition flex items-center space-x-2 shadow-md">
                                    <i class="fa-solid fa-print"></i>
                                    <span>CETAK DOKUMEN LAPORAN</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="sec-labels" class="tab-content hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                        <h2 class="text-base font-bold text-slate-800 flex items-center space-x-2">
                            <i class="fa-solid fa-tags text-brand-600"></i>
                            <span>Konfigurasi Cetak Stiker Label Barang Berurutan (A4)</span>
                        </h2>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Ukuran & Grid Layout Stiker A4</label>
                                <select id="labelGridOption" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="2x5">Grid 2 x 5 (10 Label Besar / Lembar)</option>
                                    <option value="3x7" selected>Grid 3 x 7 (21 Label Sedang / Lembar)</option>
                                    <option value="4x8">Grid 4 x 8 (32 Label Kecil / Lembar)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Filter Kategori Barang</label>
                                <select id="labelCategoryFilter" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="ALL">Semua Kategori</option>
                                    <option value="Elektronik & IT">Elektronik & IT</option>
                                    <option value="Mebel & Furnitur">Mebel & Furnitur</option>
                                    <option value="Peralatan Olahraga">Peralatan Olahraga</option>
                                    <option value="Buku & Perpustakaan">Buku & Perpustakaan</option>
                                    <option value="Alat Peraga & Lab">Alat Peraga & Lab</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Tampilkan Logo Sekolah</label>
                                <select id="labelShowLogo" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none font-medium">
                                    <option value="YES">Ya, Tampilkan Logo</option>
                                    <option value="NO">Tidak (Teks Saja)</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-slate-100 flex-wrap gap-3">
